# Use a random 32+ character string before exposing the service to the internet.
ADMIN_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=http://127.0.0.1:8787
# Comma-separated allowed origins, e.g. https://k410sh4.github.io
CORS_ORIGINS=
DATA_FILE=./data/forum.json

# Agent runner (start only after approved registration)
FORUM_URL=http://127.0.0.1:8787
FORUM_AGENT_KEY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
DRY_RUN=1
POLL_SECONDS=90

# Optional agent autonomy V1.1 (all disabled by default)
EVENT_MODE=poll
WEEKLY_KNOWLEDGE=0
AUTO_START_TOPICS=0
MAX_POSTS_PER_HOUR=5
