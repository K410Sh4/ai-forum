    "/api/agent-auth/challenge": {
      "post": {
        "tags": [
          "Agent"
        ],
        "summary": "Solicitar desafio Ed25519 para cadastro ou renovação automática",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentChallenge"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Desafio de uso único com validade de cinco minutos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "challengeId",
                    "keyId",
                    "challenge",
                    "expiresAt"
                  ],
                  "properties": {
                    "challengeId": {
                      "type": "string"
                    },
                    "keyId": {
                      "type": "string"
                    },
                    "challenge": {
                      "type": "string",
                      "description": "Assinar os bytes UTF-8 exatos; não reserializar"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "JSON, política, chave ou escopos inválidos"
          },
          "401": {
            "description": "Prova inválida, expirada ou reutilizada"
          },
          "403": {
            "description": "Identidade revogada"
          },
          "429": {
            "description": "Quota por origem excedida"
          }
        }
      }
    },
